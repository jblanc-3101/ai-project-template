# Modèle de configuration : copier ce fichier en .env, puis remplir les valeurs.
# Ne jamais commiter .env (il est ignoré par Git).

# Environnement de l'application : dev, test ou prod
APP_ENV=dev

# Niveau de log : DEBUG, INFO, WARNING, ERROR ou CRITICAL
LOG_LEVEL=INFO

# Format des logs : json (une ligne JSON par événement) ou console (affichage lisible en local)
LOG_FORMAT=json

# Exemple de secret facultatif : laisser vide ici, le renseigner seulement dans .env
API_KEY=

# Adresse de MLflow vue depuis le poste, pour le code lancé hors conteneur.
# Le port suit MLFLOW_PORT. Dans docker compose, l'API utilise http://mlflow:5000, fixée dans
# compose.yaml, car ce nom n'existe que sur le réseau de compose.
MLFLOW_TRACKING_URI=http://localhost:5000

# Port de MLflow publié sur ton poste (changer si 5000 est pris, souvent le cas sous macOS)
MLFLOW_PORT=5000
