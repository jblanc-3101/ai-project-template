# Modèle de configuration : copier ce fichier en .env, puis remplir les valeurs.
# Ne jamais commiter .env (il est ignoré par Git).

# Environnement de l'application : dev, test ou prod
APP_ENV=dev

# Niveau de log : DEBUG, INFO, WARNING, ERROR ou CRITICAL
LOG_LEVEL=INFO

# Exemple de secret facultatif : laisser vide ici, le renseigner seulement dans .env
API_KEY=
